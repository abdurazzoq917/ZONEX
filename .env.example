# Upstash / Vercel KV ulanish ma'lumotlari.
#
# Bu faylni nusxalab, ".env" nomi bilan saqlang va
# o'z qiymatlaringizni qo'ying:
#
#   Windows PowerShell:  copy .env.example .env
#
# Qiymatlarni Upstash sahifasidagi "REST API" bo'limidan olasiz.
# .env fayli GitHub'ga tushmaydi (.gitignore'da).

KV_REST_API_URL=https://xxxxx.upstash.io
KV_REST_API_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================
# ADMIN
# ============================================================
#
# Admin username bo'yicha aniqlanadi (katta-kichik harf farq
# qilmaydi). Uning nomi oldida yashil (admin) yozuvi turadi.
ADMIN_USERNAME=abdumalikov

# Ban berish uchun talab qilinadigan maxfiy so'z.
#
# BO'SH QOLDIRILSA — yuqoridagi username'ni olgan har qanday
# odam admin bo'la oladi. Ochiq saytda albatta to'ldiring.
ADMIN_KEY=

# ============================================================
# EMAIL — parolni tiklash kodi shu orqali ketadi
# ============================================================
#
# Gmail SMTP ishlatiladi. Bu yerga Gmail PAROLINGIZ EMAS,
# Google bergan maxsus "App password" yoziladi:
#
#   1. https://myaccount.google.com/security
#      -> "2-Step Verification" ni YOQING (bo'lmasa keyingi
#         qadam ochilmaydi)
#
#   2. https://myaccount.google.com/apppasswords
#      -> nom bering (masalan "ZONEX") -> Create
#      -> 16 belgili kodni ko'chirib, MAIL_PASS ga qo'ying
#
# Bu parolni istalgan payt bekor qilsangiz, Gmail hisobingizga
# ta'sir qilmaydi.
#
# BO'SH QOLDIRILSA:
#   - lokalda (npm start) kod EMAIL O'RNIGA terminalga chiqadi,
#     shunda sozlamasdan ham sinab ko'rasiz;
#   - Vercel'da esa parolni tiklash ishlamaydi.

MAIL_USER=sizning@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx

# Xat kimdan kelgani ko'rinadi. Bo'sh qoldirsangiz
# "ZONEX <MAIL_USER>" ishlatiladi.
MAIL_FROM=
