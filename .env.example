# Upstash / Vercel KV ulanish ma'lumotlari.
#
# Bu faylni nusxalab, ".env" nomi bilan saqlang va
# o'z qiymatlaringizni qo'ying:
#
#   Windows PowerShell:  copy .env.example .env
#
# Qiymatlarni Upstash sahifasidagi "REST API" bo'limidan olasiz.
# .env fayli GitHub'ga tushmaydi (.gitignore'da).

KV_REST_API_URL=https://xxxxx.upstash.io
KV_REST_API_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
