<?xml version="1.0" encoding="utf-8"?>
<!--
  Asosiy (release) konfiguratsiya — faqat HTTPS. Bu Play
  Store'ga chiqadigan build uchun ishlatiladi.

  Lokal "npm start" serveriga (HTTP) ulanib sinash uchun debug
  build'da src/debug/res/xml/network_security_config.xml
  ishlatiladi (cleartext'ga ruxsat beradi) — bu fayl EMAS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
