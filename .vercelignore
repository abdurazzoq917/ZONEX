# Vercel'ga KERAKMAS narsalar.
#
# MUHIM: `public/` bo'lsa, Vercel uni saytning ildizi deb oladi.
# Shuning uchun `public/` yuklanmaydi va sayt ildizdagi
# index.html (yuklab olish sahifasi) bilan ishlaydi.
public/

# ============================================================
# BRAUZER VERSIYASI SAYTGA CHIQMAYDI
# ============================================================
#
# Sayt — faqat YUKLAB OLISH sahifasi. O'yinning o'zi endi
# faqat Android ilovasida ishlaydi.
#
# Bu fayllar repozitoriyda QOLADI, chunki APK aynan ulardan
# yig'iladi (npm run build:native ularni public/ ga ko'chiradi).
# Lekin Vercel'ga yuklanmaydi — saytda /app degan sahifa yo'q.
#
# qr.js bundan MUSTASNO: yuklab olish sahifasidagi QR kodni
# o'sha chizadi.
app.html
client.js
game.js
hub.js
styles.css

# Native (Android) ilova — serverga aloqasi yo'q, juda katta
android/
capacitor.config.json

# Lokal server va yordamchi skriptlar
local-server.js
scripts/

# Haqiqiy o'yinchi ma'lumotlari — hech qachon yuklanmasin
world.json
.env
.env.local

# Eski arxivlar va rasmlar
*.zip
*.jpg
*.png
.vscode/
.claude/
